---
import type { Lang } from '@/i18n/ui';
import { useTranslations } from '@/i18n/utils';
import type { Project } from '@/lib/projects';
import { localeUrl } from '@/lib/url';

interface Props {
  lang: Lang;
  prev?: Project;
  next?: Project;
}
const { lang, prev, next } = Astro.props;
const t = useTranslations(lang);
const item = (p: Project) => ({
  href: localeUrl(lang, `projects/${p.slug}/`),
  title: p.title,
  year: p.data.year,
  titleLang: p.translated ? undefined : 'ko',
});
const prevItem = prev && item(prev);
const nextItem = next && item(next);
---

<nav class="project-nav container" aria-label={`${t('project.prev')} / ${t('project.next')}`}>
  <div class="inner">
    <div class="slot prev">
      {
        prevItem && (
          <a href={prevItem.href} rel="prev">
            <span class="label">← {t('project.prev')}</span>
            <span class="title" lang={prevItem.titleLang}>{prevItem.title}</span>
            <span class="year tabular">{prevItem.year}</span>
          </a>
        )
      }
    </div>
    <a class="back" href={localeUrl(lang)}>{t('project.backToList')}</a>
    <div class="slot next">
      {
        nextItem && (
          <a href={nextItem.href} rel="next">
            <span class="label">{t('project.next')} →</span>
            <span class="title" lang={nextItem.titleLang}>{nextItem.title}</span>
            <span class="year tabular">{nextItem.year}</span>
          </a>
        )
      }
    </div>
  </div>
</nav>

<style>
  .project-nav {
    margin-top: var(--space-9);
  }
  .inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: start;
    gap: var(--col-gap);
    padding-top: var(--space-5);
    border-top: 1px solid var(--line);
  }
  .slot a {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    text-decoration: none;
  }
  .next {
    text-align: right;
  }
  .next a {
    align-items: flex-end;
  }
  .label,
  .year {
    font-size: var(--text-sm);
    color: var(--fg-muted);
  }
  .title {
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
    letter-spacing: -0.015em;
    line-height: 1.25;
    transition: opacity 0.2s;
  }
  .slot a:hover .title {
    opacity: 0.6;
  }
  .back {
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--fg-muted);
    text-decoration: none;
  }
  .back:hover {
    color: var(--fg);
  }
  @media (max-width: 40rem) {
    .inner {
      grid-template-columns: 1fr 1fr;
    }
    .back {
      grid-column: 1 / -1;
      grid-row: 2;
      justify-self: center;
      margin-top: var(--space-5);
    }
    .title {
      font-size: var(--text-md);
    }
  }
</style>
