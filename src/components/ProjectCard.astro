---
import { Image } from 'astro:assets';
import { themeFromBg } from '@/lib/color';
import { categoryLabel, type Project } from '@/lib/projects';
import { localeUrl } from '@/lib/url';

interface Props {
  project: Project;
  index: number;
}
const { project, index } = Astro.props;
const { slug, data, lang } = project;
const theme = themeFromBg(data.bgColor);
const cardStyle = `--card-bg:${theme.bg};--card-fg:${theme.fg};--card-muted:${theme.vars['--fg-muted']}`;
const cats = data.category.map((c) => categoryLabel(c, lang)).join(', ');
const untranslatedLang = project.translated ? undefined : 'ko';
---

<li
  class="card-item"
  data-categories={data.category.join(' ')}
  data-year={data.year}
  data-order={data.order ?? ''}
  data-index={index}
>
  <a class="card" href={localeUrl(lang, `projects/${slug}/`)} style={cardStyle}>
    <div class="media" style={`view-transition-name: cover-${slug}; view-transition-class: cover;`}>
      <Image
        src={data.cover}
        alt={project.coverAlt}
        widths={[400, 640, 960, 1280]}
        sizes="auto, (min-width: 1100px) 30vw, (min-width: 640px) 46vw, 100vw"
        format="webp"
        loading={index < 3 ? 'eager' : 'lazy'}
        fetchpriority={index < 3 ? 'high' : 'auto'}
      />
    </div>
    <div class="caption">
      <span class="title" lang={untranslatedLang}>{project.title}</span>
      <span class="meta">
        <span class="tabular">{data.year}</span>
        <span class="cats">{cats}</span>
      </span>
    </div>
  </a>
</li>

<style>
  .card {
    position: relative;
    display: block;
    text-decoration: none;
    color: inherit;
  }
  .media {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--card-bg);
  }
  .media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.9s var(--ease), opacity 0.4s;
  }
  .caption {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding-top: var(--space-3);
  }
  .title {
    font-size: var(--text-md);
    font-weight: var(--weight-semibold);
    line-height: 1.3;
    letter-spacing: -0.015em;
  }
  .meta {
    display: flex;
    gap: var(--space-3);
    font-size: var(--text-sm);
    color: var(--fg-muted);
  }

  /* 마우스를 쓰는 기기: 호버 시 프로젝트 배경색 위에 제목·연도 표시 */
  @media (hover: hover) and (pointer: fine) {
    .caption {
      position: absolute;
      inset: 0;
      justify-content: flex-end;
      padding: var(--space-5);
      background: var(--card-bg);
      color: var(--card-fg);
      opacity: 0;
      transition: opacity 0.35s var(--ease);
    }
    .title {
      font-size: var(--text-lg);
    }
    .meta {
      color: var(--card-muted);
    }
    .card:hover .caption,
    .card:focus-visible .caption {
      opacity: 0.94;
    }
    .card:hover .media :global(img) {
      transform: scale(1.03);
    }
  }
</style>
