---
/**
 * 도면. 누르면 전체 화면으로 열리고 확대·이동할 수 있습니다 (휠/핀치/드래그).
 *
 *   <Drawing src="./plan-1f.png" caption="1층 평면도 1:200" />
 *   <Drawing src="./section.png" caption="단면도" blend />   흰 바탕을 배경색과 섞기 (밝은 배경에 적합)
 *
 * 확대 품질을 위해 도면 원본은 긴 변 3000~4000px 정도로 넣는 것을 권장합니다.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import type { Lang } from '@/i18n/ui';
import { isLang, useTranslations } from '@/i18n/utils';
import { assertImage, lightboxImage } from '@/lib/media';

interface Props {
  src: ImageMetadata;
  alt?: string;
  caption?: string;
  blend?: boolean;
  size?: 'full' | 'text';
}

const { src, alt, caption, blend = false, size = 'full' } = Astro.props;
assertImage(src, 'Drawing');
const lang: Lang = isLang(Astro.params.lang) ? Astro.params.lang : 'ko';
const t = useTranslations(lang);
const large = await lightboxImage(src, 4000);
---

<figure class:list={['drawing', 'media-block', `size-${size}`, { blend }]} data-lightbox data-kind="drawing">
  <a
    class="zoomable"
    href={large.href}
    data-pswp-width={large.width}
    data-pswp-height={large.height}
    data-caption={caption}
  >
    <Image
      src={src}
      alt={alt ?? caption ?? ''}
      widths={[640, 960, 1280, 1600, 2000, 2600]}
      sizes="auto, (min-width: 1500px) 1440px, 100vw"
      format="webp"
      loading="lazy"
    />
    <span class="zoom-hint" aria-hidden="true">
      <svg viewBox="0 0 20 20" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5">
        <circle cx="8.5" cy="8.5" r="5.5"></circle>
        <path d="M12.5 12.5 17 17M8.5 6v5M6 8.5h5"></path>
      </svg>
      <span class="hint-pointer">{t('media.zoomHint')}</span>
      <span class="hint-touch">{t('media.zoomHintTouch')}</span>
    </span>
  </a>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
