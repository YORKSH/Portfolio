---
/**
 * 이미지 그리드. 안에 <Photo>를 넣습니다. 사진을 누르면 크게 볼 수 있습니다.
 *
 *   <Gallery cols={3} ratio="4/3" caption="외관">
 *     <Photo src="./a.jpg" alt="..." />
 *     <Photo src="./b.jpg" alt="..." />
 *   </Gallery>
 *
 * cols  : 데스크톱 열 수 (1~4, 기본 2). 모바일에서는 자동으로 1~2열
 * ratio : 모든 사진을 같은 비율로 잘라 보여줄 때 (예: "1/1", "4/3", "3/2")
 */
interface Props {
  cols?: number;
  ratio?: string;
  caption?: string;
  size?: 'full' | 'text';
}

const { cols = 2, ratio, caption, size = 'full' } = Astro.props;
const c = Math.min(4, Math.max(1, Math.round(cols)));
const style = [`--cols:${c}`, `--cols-md:${Math.min(c, 3)}`, `--cols-sm:${c >= 3 ? 2 : 1}`, ratio && `--ratio:${ratio}`]
  .filter(Boolean)
  .join(';');
---

<figure class:list={['gallery', 'media-block', `size-${size}`]} style={style} data-lightbox data-ratio={ratio ? '' : undefined}>
  <div class="gallery-grid">
    <slot />
  </div>
  {caption && <figcaption class="gallery-caption">{caption}</figcaption>}
</figure>
